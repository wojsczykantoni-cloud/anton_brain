<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antonbrain.garminsync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/antoniwojsczyk/anton_brain/scripts/refresh_all.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/antoniwojsczyk/anton_brain</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Przy logowaniu / załadowaniu. Terminy przespane przez Maca launchd
         odpala po wybudzeniu (jeden raz, nawet jeśli minęło kilka). -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>11</integer>
            <key>Minute</key>
            <integer>20</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Skrypt loguje sam (z datą) do logs/refresh.log; tu trafia tylko to,
         co wymknęło się logowaniu. -->
    <key>StandardOutPath</key>
    <string>/Users/antoniwojsczyk/anton_brain/logs/launchd-jobs.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/antoniwojsczyk/anton_brain/logs/launchd-jobs.log</string>
</dict>
</plist>
